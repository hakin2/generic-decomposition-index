# Build output
out/
*.class

# Downloaded SNAP graphs; regenerable from the commands in README.md.
# Hand-built graphs and query sets remain trackable.
data/*.el
data/*.gz

# Generated results. Only the artifacts REPORT.md cites are kept: the figures
# and the per-query CSVs. Index dumps and raw query output are large and
# regenerable. The re-include dance is required because excluding a directory
# stops git descending into it at all.
results/*
!results/*/
results/*/*
!results/*/*.csv
!results/*/*.png

# Compact aggregate tables cited by REPORT.md.
!results/summary/
!results/summary/*.csv

# Python bytecode
__pycache__/
*.pyc